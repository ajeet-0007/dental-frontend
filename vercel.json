{
  "headers": [
    {
      "source": "/(.*\\.webmanifest)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*\\.(js|css|json|png|svg|ico|webmanifest))", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
